# ─────────────────────────────────────────────────────────
# JIRA
# ─────────────────────────────────────────────────────────
# Prototipo personal:  https://tu-dominio.atlassian.net
# Flexicar producción: https://flexicar.atlassian.net
JIRA_BASE_URL=https://tu-dominio.atlassian.net

JIRA_EMAIL=gerx97@gmail.com

# Generar en: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=ATATT3xFfGF...

# Clave del proyecto PO (se crea con `po setup`)
JIRA_PO_PROJECT_KEY=FP

# Clave del proyecto DEV existente en Flexicar
JIRA_DEV_PROJECT_KEY=FI

# ─────────────────────────────────────────────────────────
# CAMPOS CUSTOM (se rellenan tras ejecutar `po setup`)
# ─────────────────────────────────────────────────────────
# Ejemplo: customfield_10100
JIRA_FIELD_DOR_SCORE=
JIRA_FIELD_DOR_GAPS=
JIRA_FIELD_IA_ASISTIDA=
JIRA_FIELD_TIPO_PETICION=
JIRA_FIELD_VALIDADOR_UAT=
JIRA_FIELD_FECHA_SIGNOFF=

# ─────────────────────────────────────────────────────────
# CLAUDE API (Anthropic)
# ─────────────────────────────────────────────────────────
# Generar en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# claude-sonnet-4-6 (económico, prototipo)
# claude-opus-4-7   (mejor calidad, producción)
CLAUDE_MODEL=claude-sonnet-4-6

# ─────────────────────────────────────────────────────────
# DOCUMENTACIÓN
# ─────────────────────────────────────────────────────────
# Ruta a la carpeta 05_Modelo_Operativo_PO (para cargar checklists vivas)
# Prototipo: ruta local
# Producción: puede ser URL raw de un repo git
DOCS_PATH=C:/Users/gerx_/Desktop/Flexicar/05_Modelo_Operativo_PO

# ─────────────────────────────────────────────────────────
# EQUIPO PO (para dashboard y alertas)
# ─────────────────────────────────────────────────────────
# Formato: nombre:email separados por coma
PO_TEAM=PO1:po1@empresa.es,PO2:po2@empresa.es

PE_EMAIL=pe@empresa.es

# ─────────────────────────────────────────────────────────
# ENTORNO
# ─────────────────────────────────────────────────────────
ENVIRONMENT=development

# Si true, simula todo sin escribir en Jira (útil para tests y demos offline)
DRY_RUN=false
